# ==============================================================================
# Blinkit Customer Feedback Intelligence & RAG Discovery Engine
# Environment Configuration Template (.env.example)
# ==============================================================================

# Google AI Studio Gemini API Configuration
GEMINI_API_KEY="AQ."

# Google AI Studio Throttling Parameters (Free Tier Specs)
GOOGLE_AI_STUDIO_RPM_LIMIT=60Ab8RN6LDDdmR8MdfOd7kJgoZK3Y6WXUEZIMGtpLkLQXs5lMnng
GOOGLE_AI_STUDIO_TPM_LIMIT=100000

# RAG & Vector Search Precision Config
COSINE_SIMILARITY_THRESHOLD=0.75
EMBEDDING_MODEL="text-embedding-3-small"
EMBEDDING_DIM=1536

# Data Ingestion & PII Filtering Config
TARGET_APP_PACKAGE="com.grofers.inkart"
TARGET_CORPUS_INGESTION_COUNT=5000
MIN_WORD_COUNT=8

# Streamlit Server Production Config
STREAMLIT_SERVER_PORT=8501
STREAMLIT_SERVER_ADDRESS="0.0.0.0"

# Application System Environment
ENVIRONMENT="production"
LOG_LEVEL="INFO"
